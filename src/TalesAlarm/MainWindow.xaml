<Window x:Class="TalesAlarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TalesAlarm.Views.Controls"
        xmlns:timers="clr-namespace:TalesAlarm.Timers"
        mc:Ignorable="d"
        Title="Tales Alarm"
        Width="1100"
        Height="760"
        MinWidth="1040"
        MinHeight="720"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="TimerCardTemplate">
            <Border Style="{StaticResource CardBorder}" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Text="{Binding TimerIndex, StringFormat='타이머 {0}'}" />
                        <Border Grid.Column="1"
                                Padding="10,5"
                                Background="#DBEAFE"
                                CornerRadius="12">
                            <TextBlock Foreground="#1E40AF"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusText}" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,18,0,18"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="56"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Text="{Binding DisplayTime}" />

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 HorizontalContentAlignment="Center"
                                 controls:NumericTextBoxBehavior.Mode="Digits"
                                 Text="{Binding Hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Text="시간" />
                        <TextBox Grid.Column="2"
                                 HorizontalContentAlignment="Center"
                                 controls:NumericTextBoxBehavior.Mode="Digits"
                                 Text="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="3" Margin="7,0" VerticalAlignment="Center" Text="분" />
                        <TextBox Grid.Column="4"
                                 HorizontalContentAlignment="Center"
                                 controls:NumericTextBoxBehavior.Mode="Digits"
                                 Text="{Binding Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="전역 단축키" />
                        <controls:HotkeyCaptureBox Grid.Column="1"
                                                   Gesture="{Binding Hotkey, Mode=TwoWay}"
                                                   CaptureStarted="OnCaptureStarted"
                                                   CaptureEnded="OnCaptureEnded"
                                                   ToolTip="클릭한 뒤 원하는 키 조합을 누르세요." />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="재입력 동작" />
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding ReactivationPolicy, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="처음부터 다시 시작"
                                          Tag="{x:Static timers:ReactivationPolicy.Restart}" />
                            <ComboBoxItem Content="일시정지 · 재개"
                                          Tag="{x:Static timers:ReactivationPolicy.PauseResume}" />
                            <ComboBoxItem Content="입력 무시"
                                          Tag="{x:Static timers:ReactivationPolicy.Ignore}" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCommand}"
                                    Content="시작" />
                            <Button Grid.Column="1"
                                    Command="{Binding PauseResumeCommand}"
                                    Content="일시정지 / 재개" />
                            <Button Grid.Column="2"
                                    Command="{Binding ResetCommand}"
                                    Content="초기화" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   MinHeight="20"
                                   Margin="4,6,4,0"
                                   Foreground="#B91C1C"
                                   TextWrapping="Wrap"
                                   Text="{Binding ValidationMessage}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,0,8,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Text="Tales Alarm" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#475569"
                               Text="두 개의 타이머를 전역 단축키로 독립 제어합니다." />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="132"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplySettingsCommand}"
                        Content="설정 적용" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0"
                                Content="{Binding Timer1}"
                                ContentTemplate="{StaticResource TimerCardTemplate}" />
                <ContentControl Grid.Column="1"
                                Content="{Binding Timer2}"
                                ContentTemplate="{StaticResource TimerCardTemplate}" />
            </Grid>

            <Border Grid.Row="2"
                    Margin="8,10,8,8"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Text="알람 음원" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="15"
                                       Foreground="#475569"
                                       Text="{Binding Alarm.CurrentFileName, StringFormat='현재 음원: {0}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="OnChangeAudioClick" Content="음원 변경" />
                            <Button Command="{Binding Alarm.PreviewCommand}" Content="미리 듣기" />
                            <Button Command="{Binding Alarm.RestoreDefaultCommand}" Content="기본음 복원" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="재생 시간" />
                        <TextBox Grid.Column="1"
                                 Margin="12,0,6,0"
                                 HorizontalContentAlignment="Center"
                                 controls:NumericTextBoxBehavior.Mode="Decimal"
                                 Text="{Binding Alarm.PlaybackSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="초 (0.1~60.0)" />
                        <TextBlock Grid.Column="3"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#B91C1C"
                                   TextWrapping="Wrap"
                                   Text="{Binding Alarm.ValidationMessage}" />
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Foreground="#B91C1C"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding ErrorMessage}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#166534"
                                   TextWrapping="Wrap"
                                   Text="{Binding NoticeMessage}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
